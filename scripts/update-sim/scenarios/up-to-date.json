{
  "description": "The manifest offers nothing newer than the installed app",
  "manifest": {
    "version": "0.1.0",
    "build": 1,
    "package": true
  },
  "expect": [
    {
      "kind": "requested",
      "path": "latest.json"
    },
    {
      "kind": "not-requested",
      "path": ".nshpkg"
    },
    {
      "kind": "absent",
      "name": "next.nshpkg"
    },
    {
      "kind": "absent",
      "name": "trying.nshpkg"
    },
    {
      "kind": "absent",
      "name": "current.nshpkg"
    }
  ],
  "checks": true
}
