{
  "description": "A manifest for another app is rejected",
  "manifest": {
    "version": "0.1.1",
    "build": 2,
    "package": true
  },
  "tamper": {
    "file": "latest.json",
    "kind": "replace-id"
  },
  "expect": [
    {
      "kind": "absent",
      "name": "next.nshpkg"
    },
    {
      "kind": "absent",
      "name": "current.nshpkg"
    },
    {
      "kind": "log-contains",
      "text": "native_failure"
    },
    {
      "kind": "requested",
      "path": "latest.json"
    }
  ],
  "checks": true
}
